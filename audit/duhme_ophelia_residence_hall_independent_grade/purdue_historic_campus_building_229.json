    {
      "attributes": {
        "OBJECTID": 229,
        "ABBR": "DUHM",
        "Name": "Ophelia Duhme Residence Hall",
        "OTHER_ABBR": " ",
        "OWNER": "PURDUE",
        "ADDRESS": "209 N. Russell Street",
        "BUILTYear": -1135987200000,
        "OCCUPIEDYear": -1128297600000,
        "RazeYear": 253402214399000,
        "Shape.STArea()": 1817.800606335,
        "Shape.STLength()": 252.26541437054652,
        "description": "Ophelia Duhme Residence hall is a four-story brick, stone, and reinforced concrete structure consisting of a central portion (42x32 ft.) and two wings each (42x109 ft.) with a fireproof roof. It contains 73 rooms, a main living room, two lounges with kitchenette, four reception rooms, a large recreation room, a completely equipped kitchen, a laundry room, and a four-bed infirmary. Originally designated as Women's Residence Hall South, the Women's Residence Halls were the first residence halls for women on Purdue's Campus. A lot of debate went in to planning this construction process and the fees associated with living in the new residence hall, as shown in the Board of Trustees Minutes. The building was renamed Ophelia Duhme Hall in 1942 and then Ophelia Duhme Residence Hall in 1969. All 5 women's residence halls were also referred to as Windsor Residence Halls on August 27,1969. Windsor was designed so that nearly every room in each hall would receive sunlight sometime during the d...",
        "buildingidlong": 351,
        "ChangeYear": 1514764800000,
        "constructionbeginyear": 1934,
        "constructionendyear": 1934,
        "cost": 259000.0,
        "dedicationdate": "1934-10-20",
        "dedicationinfo": "This building is dedicated to Ophelia Fowler Duhme who gifted land to the university in 1925. The funds acquired from this land were used to build a women's dormitory.",
        "presidentatconstruction": "Edward C. Elliott",
        "squarefootage": null
      },
