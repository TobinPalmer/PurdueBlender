                                  <line stroke-linecap="round" stroke-linejoin="round" transform="translate(25.6897, 26.6047) rotate(-90) translate(-25.6897, -26.6047)" x1="25.6896552" x2="25.6896552" y1="14.5116279" y2="38.6976744"/>
                                </g>
